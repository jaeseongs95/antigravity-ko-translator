{
  "ko-thought-translator-lifecycle": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/ensure_ko_thought_patch.js --hook",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/ensure_ko_thought_patch.js --hook",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/ensure_ko_thought_patch.js --hook",
        "timeout": 5
      }
    ]
  }
}
