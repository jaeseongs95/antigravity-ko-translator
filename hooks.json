{
  "ko-thought-translator-lifecycle": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node -e \"process.argv.push('--hook');require(require('os').homedir()+'/.gemini/config/plugins/ko-thought-translator/scripts/ensure_ko_thought_patch.js')\"",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node -e \"process.argv.push('--hook');require(require('os').homedir()+'/.gemini/config/plugins/ko-thought-translator/scripts/ensure_ko_thought_patch.js')\"",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node -e \"process.argv.push('--hook');require(require('os').homedir()+'/.gemini/config/plugins/ko-thought-translator/scripts/ensure_ko_thought_patch.js')\"",
        "timeout": 5
      }
    ]
  }
}
