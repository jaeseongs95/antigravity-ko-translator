{
  "name": "antigravity-ko-translator",
  "version": "2.0.0",
  "description": "Real-time Korean localization for Antigravity 2.0 Thinking blocks and static UI with strict Hexagonal CommonJS architecture, CSP/TrustedTypes Remote Control promotion, and StatusBarAdapter integration.",
  "private": true,
  "scripts": {
    "build": "node ./scripts/build.js",
    "build:check": "node ./scripts/build.js --check",
    "test:unit": "node --test test/unit/*.test.js",
    "test:e2e": "node --test test/e2e/remote-control-cdp.test.js",
    "test": "node ./scripts/build.js --check && node --test test/unit/*.test.js test/e2e/remote-control-cdp.test.js",
    "sync:mirrors": "node ./scripts/ensure_ko_thought_patch.js --sync-mirrors",
    "patch": "node ./scripts/ensure_ko_thought_patch.js --worker",
    "status": "node ./scripts/ensure_ko_thought_patch.js --status",
    "uninstall": "node ./scripts/ensure_ko_thought_patch.js --uninstall",
    "rollback": "node ./scripts/ensure_ko_thought_patch.js --rollback"
  },
  "license": "MIT"
}
