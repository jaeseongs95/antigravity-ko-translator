{
  "name": "antigravity-ko-translator",
  "version": "2.4.0",
  "description": "Antigravity Korean Thinking & Static UI Translator for Desktop & Remote Web (AddonManifest.v2 Renderer-Only Plugin + Public HTTPS Modular Userscript + GM_xmlhttpRequest CSP/CORS Transport + Host settingsBridge).",
  "private": true,
  "scripts": {
    "build": "node ./scripts/build.js",
    "build:check": "node ./scripts/build.js --check",
    "test:unit": "node --test test/unit/*.test.js",
    "test": "node ./scripts/build.js --check && node --test test/unit/*.test.js",
    "install:addon": "node ./scripts/ensure_ko_thought_patch.js --install",
    "install:loader": "node ./scripts/ensure_ko_thought_patch.js --install",
    "status": "node ./scripts/ensure_ko_thought_patch.js --status",
    "uninstall:addon": "node ./scripts/ensure_ko_thought_patch.js --uninstall",
    "uninstall:loader": "node ./scripts/ensure_ko_thought_patch.js --uninstall",
    "rollback": "node ./scripts/ensure_ko_thought_patch.js --rollback"
  },
  "license": "MIT",
  "dependencies": {
    "ipaddr.js": "^2.5.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4"
  }
}
