{
  "name": "antigravity-ko-translator",
  "version": "2.0.0",
  "description": "Antigravity Desktop Native App Korean Thinking & Static UI Translator (Pure Read-Only DOM Overlay + Official Sidecar Settings + Shared Drop-In Loader).",
  "private": true,
  "scripts": {
    "build": "node ./scripts/build.js",
    "build:check": "node ./scripts/build.js --check",
    "test:unit": "node --test test/unit/*.test.js",
    "test": "node ./scripts/build.js --check && node --test test/unit/*.test.js",
    "install:loader": "node ./scripts/ensure_ko_thought_patch.js --install",
    "status": "node ./scripts/ensure_ko_thought_patch.js --status",
    "uninstall:loader": "node ./scripts/ensure_ko_thought_patch.js --uninstall",
    "rollback": "node ./scripts/ensure_ko_thought_patch.js --rollback"
  },
  "license": "MIT"
}
